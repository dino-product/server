SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
MANAGEMENT_PORT=9090

DATABASE_URL=jdbc:postgresql://localhost:54321/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=54321
TZ=UTC

REDIS_HOST=localhost
REDIS_PORT=6379

CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:5173
OPENAPI_ENABLED=true
P6SPY_ENABLE_LOGGING=true

# 카카오 개발자 콘솔의 앱 키. 앱은 네이티브 앱 키, 웹은 REST API 키를 id_token aud로 받으므로 둘 다 나열한다.
# 반드시 같은 카카오 앱의 키만 나열한다. 다른 앱의 키를 섞으면 앱별 회원번호가 같은 사용자가 한 계정으로 합쳐진다.
KAKAO_ALLOWED_AUDIENCES=your-native-app-key,your-rest-api-key

# Apple 로그인 클라이언트 식별자. iOS 앱은 Bundle ID, 웹·Android는 Services ID를 id_token aud로 받으므로 둘 다 나열한다.
# 같은 Apple 개발자 팀의 클라이언트만 나열한다(Apple sub는 팀 단위로 같아 한 계정으로 합쳐진다).
APPLE_ALLOWED_AUDIENCES=your.bundle.id,your.services.id
# Apple 토큰 API(code 교환·토큰 철회)용 client_secret 서명 정보: Team ID, Sign in with Apple 키 ID, 그 키의 .p8 내용.
# .p8은 줄바꿈을 \n으로 적은 한 줄 PEM 또는 BEGIN/END 줄을 뺀 base64로 넣는다. 실제 키는 이 파일에 적지 않는다.
APPLE_TEAM_ID=your-team-id
APPLE_KEY_ID=your-key-id
APPLE_PRIVATE_KEY=replace-with-p8-private-key
APPLE_CLIENT_SECRET_TTL=PT10M

# 자체 Access JWT 서명 비밀키(32바이트 이상, 운영은 무작위 값으로 교체)·발급자·유효 기간(ISO-8601 Duration)
AUTH_JWT_SECRET=local-only-secret-key-with-at-least-32-bytes
AUTH_JWT_ISSUER=orbit
AUTH_ACCESS_TOKEN_TTL=PT1H

SCHEDULE_TECHNICIAN_LOCK_WAIT_LIMIT=2s
