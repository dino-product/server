root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
max_line_length = 120

[*.{yml,yaml}]
indent_size = 2

[*.{gradle,gradle.kts}]
indent_size = 4

[*.md]
max_line_length = 9999
trim_trailing_whitespace = false
