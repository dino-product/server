{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew spotlessApply:*)",
      "Bash(./gradlew spotlessCheck:*)",
      "Bash(./gradlew checkstyleMain:*)",
      "Bash(./gradlew checkstyleTest:*)",
      "Bash(./gradlew compileJava:*)",
      "Bash(./gradlew compileTestJava:*)",
      "Bash(./gradlew bootJar:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(python3 .github/scripts/check_pr_metadata.py:*)",
      "Bash(python3 .github/scripts/check_markdown_links.py:*)",
      "Bash(python3 .claude/skills/dino-pr/scripts/pr_draft.py:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git commit --amend:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git clean:*)",
      "Bash(git checkout --:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git worktree remove:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew check:*)",
      "Bash(./gradlew build:*)",
      "Bash(./gradlew bootRun:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker compose down:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh release:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.prod)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_commit_message.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
